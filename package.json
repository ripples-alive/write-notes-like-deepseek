{
  "name": "write-notes-like-deepseek",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "通用项目工程决策记录、校验与归档工具",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ripples-alive/write-notes-like-deepseek.git"
  },
  "scripts": {
    "verify-agent-note-tree": "node skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-archived": "node skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "node skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts && node skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts && node skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "archive-agent-note": "node skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "check-anchors": "node skills/write-notes-like-deepseek/scripts/check-note-anchors.ts",
    "init-board": "node skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html '工程决策看板'",
    "bundle-board": "node skills/write-notes-like-deepseek/scripts/build-board.ts --bundle .agents/notes demo.html '工程决策看板'",
    "build-board": "node skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html '工程决策看板'",
    "test-note-safety": "node --test scripts/test-note-safety.mjs",
    "test-skill-package": "node scripts/test-skill-install.mjs --offline",
    "test": "npm run test-note-safety && npm run test-skill-package",
    "test-skill-install": "node scripts/test-skill-install.mjs"
  }
}
